        grid-template-rows: 1fr 1fr;
        gap: 15px;

        img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            border-radius: 8px;
            cursor: pointer;
            transition: opacity 0.3s;
        }

        img:hover {
            opacity: 0.9;
        }
    }

    .video {
        width: 50%;

        video {
            width: 100%;
            height: 100%;
            object-fit: cover;
            border-radius: 8px;
            cursor: pointer;
            transition: opacity 0.3s;
        }

        video:hover {
            opacity: 0.9;
        }
    }
}

